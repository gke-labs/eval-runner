set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

echo "=== 1. Testing platform check with fake inspect outputs ==="

# Source functions from dev/tasks/deploy
# shellcheck source=dev/tasks/deploy
source "${REPO_ROOT}/dev/tasks/deploy"

# Test Case A: Valid multi-arch inspect output (amd64 + arm64)
FAKE_MULTI_ARCH="Name:      gcr.io/test-project/eval-runner:835f2bf
MediaType: application/vnd.oci.image.index.v1+json
Digest:    sha256:1111111111111111111111111111111111111111111111111111111111111111

Manifests:
  Name:        gcr.io/test-project/eval-runner:835f2bf@sha256:2222222222222222222222222222222222222222222222222222222222222222
  MediaType:   application/vnd.oci.image.manifest.v1+json
  Platform:    linux/amd64

  Name:        gcr.io/test-project/eval-runner:835f2bf@sha256:3333333333333333333333333333333333333333333333333333333333333333
  MediaType:   application/vnd.oci.image.manifest.v1+json
  Platform:    linux/arm64"

if ! verify_index_has_amd64 "${FAKE_MULTI_ARCH}" "gcr.io/test-project/eval-runner:835f2bf"; then
  echo "FAIL: Expected multi-arch inspect output with linux/amd64 to pass." >&2
  exit 1
fi
echo "PASS: Multi-arch inspect with linux/amd64 accepted."

# Test Case B: Stale arm64-only inspect output (lacks amd64)
FAKE_ARM64_ONLY="Name:      gcr.io/test-project/eval-runner:835f2bf
MediaType: application/vnd.oci.image.index.v1+json
Digest:    sha256:1111111111111111111111111111111111111111111111111111111111111111

Manifests:
  Name:        gcr.io/test-project/eval-runner:835f2bf@sha256:3333333333333333333333333333333333333333333333333333333333333333
  MediaType:   application/vnd.oci.image.manifest.v1+json
  Platform:    linux/arm64"

ERR_OUT="$(verify_index_has_amd64 "${FAKE_ARM64_ONLY}" "gcr.io/test-project/eval-runner:835f2bf" 2>&1 || true)"
if echo "${ERR_OUT}" | grep -q "ERROR: Pushed image index 'gcr.io/test-project/eval-runner:835f2bf' does not contain 'linux/amd64' platform."; then
  echo "PASS: Arm64-only inspect output rejected fast with expected error message."
else
  echo "FAIL: Arm64-only inspect output was not rejected with expected error message. Got: ${ERR_OUT}" >&2
  exit 1
fi

# Test Case C: Empty inspect output
EMPTY_ERR_OUT="$(verify_index_has_amd64 "" "gcr.io/test-project/eval-runner:835f2bf" 2>&1 || true)"
if echo "${EMPTY_ERR_OUT}" | grep -q "ERROR: Pushed image index 'gcr.io/test-project/eval-runner:835f2bf' does not contain 'linux/amd64' platform."; then
  echo "PASS: Empty inspect output rejected fast."
else
  echo "FAIL: Empty inspect output did not fail properly. Got: ${EMPTY_ERR_OUT}" >&2
  exit 1
fi

echo "=== 2. Testing that dev/tasks/deploy ignores bogus PATH ap binary ==="

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "${TMP_DIR}"' EXIT

# Create a bogus ap binary that fails if executed
cat << 'EOF' > "${TMP_DIR}/ap"
#!/bin/sh
echo "FATAL: Bogus PATH ap binary was executed!" >&2
exit 99
EOF
chmod +x "${TMP_DIR}/ap"

# Run ./dev/tasks/deploy --dry-run with bogus ap first on PATH
DEPLOY_OUT="$(PATH="${TMP_DIR}:${PATH}" "${REPO_ROOT}/dev/tasks/deploy" --dry-run 2>&1)"
if echo "${DEPLOY_OUT}" | grep -q "Bogus PATH ap binary was executed"; then
  echo "FAIL: dev/tasks/deploy used PATH ap binary instead of go run!" >&2
  exit 1
fi
echo "PASS: dev/tasks/deploy ignored bogus PATH ap binary and invoked ap via go run."

echo "=== 3. Testing that runner-deployment.yaml does not mention sample-runner and deploy performs no rewrites ==="
if grep -q "sample-runner" "${REPO_ROOT}/k8s/runner-deployment.yaml"; then
  echo "FAIL: k8s/runner-deployment.yaml mentions sample-runner!" >&2
  exit 1
fi
echo "PASS: k8s/runner-deployment.yaml does not mention sample-runner."

DEPLOY_HASH_BEFORE="$(sha256sum "${REPO_ROOT}/k8s/runner-deployment.yaml" | awk '{print $1}')"
"${REPO_ROOT}/dev/tasks/deploy" --dry-run >/dev/null 2>&1 || true
DEPLOY_HASH_AFTER="$(sha256sum "${REPO_ROOT}/k8s/runner-deployment.yaml" | awk '{print $1}')"

if [[ "${DEPLOY_HASH_BEFORE}" != "${DEPLOY_HASH_AFTER}" ]]; then
  echo "FAIL: dev/tasks/deploy modified k8s/runner-deployment.yaml!" >&2
  exit 1
fi
echo "PASS: dev/tasks/deploy performs no file rewrites on runner-deployment.yaml."

echo "=== 4. Testing that runner-deployment.yaml contains no deployment-specific flags ==="
for flag in "--artifact-bucket" "--discovery-deadline" "--execution-deadline" "--max-parallel-tasks" "--model-secret" "--poll-progress-interval" "--sample-runner-image"; do
  if grep -q -- "${flag}" "${REPO_ROOT}/k8s/runner-deployment.yaml"; then
    echo "FAIL: k8s/runner-deployment.yaml contains deployment-specific flag '${flag}'!" >&2
    exit 1
  fi
done
echo "PASS: k8s/runner-deployment.yaml passes no deployment-specific flags."

echo "=== 5. Testing deploy manifest verification guard ==="

# Test Case 5A: Valid dry run output containing only this repo's k8s/*.yaml manifests
VALID_DRY_RUN="deploy-eval-runner
  port-forward-build-images
    build-images
      docker-build-eval-runner-ui
      docker-build-eval-runner-webhook
      docker-build-eval-runner
      docker-build-git-server
      docker-build-sample-runner
  deploy-k8s
    kubectl-apply-00-namespaces.yaml
    kubectl-apply-evalrunner.gke-labs.dev_comparisons.yaml
    kubectl-apply-evalrunner.gke-labs.dev_runs.yaml
    kubectl-apply-rbac.yaml
    kubectl-apply-runner-deployment.yaml
    kubectl-apply-sandbox-networkpolicy.yaml
    kubectl-apply-ui-deployment.yaml
    kubectl-apply-webhook-deployment.yaml"

if ! verify_deploy_manifests_output "${VALID_DRY_RUN}"; then
  echo "FAIL: Expected valid dry-run output to pass verification." >&2
  exit 1
fi
echo "PASS: Valid dry-run manifest output accepted."

# Test Case 5B: Foreign manifest in dry-run output (e.g. from agent-sandbox fork)
FOREIGN_DRY_RUN="${VALID_DRY_RUN}
    kubectl-apply-controller.yaml"

ERR_OUT="$(verify_deploy_manifests_output "${FOREIGN_DRY_RUN}" 2>&1 || true)"
if echo "${ERR_OUT}" | grep -q "Discovered manifest 'controller.yaml' does not exist"; then
  echo "PASS: Foreign manifest 'controller.yaml' rejected fast."
else
  echo "FAIL: Foreign manifest in dry-run output was not rejected with expected error. Got: ${ERR_OUT}" >&2
  exit 1
fi

# Test Case 5C: Path outside k8s/ (e.g. Applying manifest .build/agent-sandbox/k8s/controller.yaml)
PATH_OUT="Applying manifest .build/agent-sandbox/k8s/controller.yaml"
ERR_OUT="$(verify_deploy_manifests_output "${PATH_OUT}" 2>&1 || true)"
if echo "${ERR_OUT}" | grep -q "outside k8s/"; then
  echo "PASS: Manifest path outside k8s/ rejected fast."
else
  echo "FAIL: Path outside k8s/ was not rejected. Got: ${ERR_OUT}" >&2
  exit 1
fi

# Test Case 5D: Empty manifests output
ERR_OUT="$(verify_deploy_manifests_output "" 2>&1 || true)"
if echo "${ERR_OUT}" | grep -q "ap deploy --dry-run produced no kubectl-apply tasks"; then
  echo "PASS: Empty manifests output rejected fast."
else
  echo "FAIL: Empty manifests output was not rejected. Got: ${ERR_OUT}" >&2
  exit 1
fi

# Test Case 5E: dev/tasks/deploy --dry-run fails when foreign k8s directory is present
mkdir -p "${REPO_ROOT}/.build/agent-sandbox/k8s"
touch "${REPO_ROOT}/.build/agent-sandbox/k8s/controller.yaml"
DEPLOY_ERR="$("${REPO_ROOT}/dev/tasks/deploy" --dry-run 2>&1 || true)"
rm -rf "${REPO_ROOT}/.build/agent-sandbox"

if echo "${DEPLOY_ERR}" | grep -q "ERROR: Found unauthorized k8s directory"; then
  echo "PASS: dev/tasks/deploy --dry-run rejected foreign k8s directory."
else
  echo "FAIL: dev/tasks/deploy --dry-run did not reject foreign k8s directory. Got: ${DEPLOY_ERR}" >&2
  exit 1
fi

# Test Case 5F: dev/tasks/deploy --dry-run fails when foreign images directory is present
mkdir -p "${REPO_ROOT}/.build/agent-sandbox/images/sample"
touch "${REPO_ROOT}/.build/agent-sandbox/images/sample/Dockerfile"
DEPLOY_ERR="$("${REPO_ROOT}/dev/tasks/deploy" --dry-run 2>&1 || true)"
rm -rf "${REPO_ROOT}/.build/agent-sandbox"

if echo "${DEPLOY_ERR}" | grep -q "ERROR: Found unauthorized images directory"; then
  echo "PASS: dev/tasks/deploy --dry-run rejected foreign images directory."
else
  echo "FAIL: dev/tasks/deploy --dry-run did not reject foreign images directory. Got: ${DEPLOY_ERR}" >&2
  exit 1
fi

# Test Case 5G: build-sandboxd cleans up legacy .build/agent-sandbox, clones out of tree,
# and dev/tasks/deploy --dry-run lists only this repo's k8s/ manifests.
mkdir -p "${REPO_ROOT}/.build/agent-sandbox/k8s"
touch "${REPO_ROOT}/.build/agent-sandbox/k8s/controller.yaml"

TEST_CLONE_DIR="$(mktemp -d)/test-agent-sandbox"
AGENT_SANDBOX_DIR="${TEST_CLONE_DIR}" "${REPO_ROOT}/dev/tasks/build-sandboxd" --clone-only

if [[ -d "${REPO_ROOT}/.build/agent-sandbox" ]]; then
  echo "FAIL: build-sandboxd failed to clean up legacy .build/agent-sandbox directory!" >&2
  exit 1
fi
if [[ ! -d "${TEST_CLONE_DIR}" ]]; then
  echo "FAIL: build-sandboxd failed to create out-of-tree checkout at ${TEST_CLONE_DIR}!" >&2
  exit 1
fi
rm -rf "$(dirname "${TEST_CLONE_DIR}")"

# Verify actual dev/tasks/deploy --dry-run succeeds and lists only this repo's k8s/*.yaml manifests
DRY_RUN_OUT="$("${REPO_ROOT}/dev/tasks/deploy" --dry-run)"
if ! verify_deploy_manifests_output "${DRY_RUN_OUT}"; then
  echo "FAIL: ap deploy --dry-run failed manifest verification after build-sandboxd!" >&2
  exit 1
fi
echo "PASS: ap deploy --dry-run lists only this repo's k8s/ manifests after build-sandboxd."

echo "=== 6. Testing dev/tasks/versions.sh and synchronization with e2e harness ==="
# shellcheck source=dev/tasks/versions.sh
source "${REPO_ROOT}/dev/tasks/versions.sh"

if [[ -z "${AGENT_SANDBOX_VERSION:-}" ]]; then
  echo "FAIL: AGENT_SANDBOX_VERSION is not defined in dev/tasks/versions.sh" >&2
  exit 1
fi

HARNESS_VERSION="$(grep 'AgentSandboxVersion =' "${REPO_ROOT}/tests/e2e/harness.go" | sed -E 's/.*"([^"]+)".*/\1/')"
if [[ "${AGENT_SANDBOX_VERSION}" != "${HARNESS_VERSION}" ]]; then
  echo "FAIL: AGENT_SANDBOX_VERSION (${AGENT_SANDBOX_VERSION}) does not match harness.go (${HARNESS_VERSION})" >&2
  exit 1
fi
echo "PASS: AGENT_SANDBOX_VERSION (${AGENT_SANDBOX_VERSION}) matches tests/e2e/harness.go."

echo "=== 7. Testing dev/tasks/build-sandboxd platform default ==="
MOCK_BIN="${TMP_DIR}/bin"
mkdir -p "${MOCK_BIN}"
cat << EOF > "${MOCK_BIN}/docker"
#!/bin/sh
echo "mock-docker: \$@" >> "${TMP_DIR}/docker.log"
exit 0
EOF
chmod +x "${MOCK_BIN}/docker"

BUILD_LOG="${TMP_DIR}/build-sandboxd.log"
BUILD_STATUS=0
(
  export DOCKER="${MOCK_BIN}/docker"
  export PATH="${MOCK_BIN}:${PATH}"
  export AGENT_SANDBOX_DIR="${TMP_DIR}/fake-agent-sandbox"
  mkdir -p "${AGENT_SANDBOX_DIR}/packages/sandboxd"
  touch "${AGENT_SANDBOX_DIR}/packages/sandboxd/Dockerfile"
  "${REPO_ROOT}/dev/tasks/build-sandboxd"
) > "${BUILD_LOG}" 2>&1 || BUILD_STATUS=$?

if [[ ${BUILD_STATUS} -eq 0 ]] && grep -q -- "--platform linux/amd64" "${TMP_DIR}/docker.log" 2>/dev/null; then
  echo "PASS: dev/tasks/build-sandboxd builds for linux/amd64 by default."
else
  echo "FAIL: dev/tasks/build-sandboxd did not build for linux/amd64 by default. (exit status: ${BUILD_STATUS})" >&2
  echo "Mock docker log: $(cat "${TMP_DIR}/docker.log" 2>/dev/null || true)" >&2
  echo "build-sandboxd output:" >&2
  cat "${BUILD_LOG}" >&2
  exit 1
fi

echo "=== 8. Testing dev/tasks/deploy-to-kube ==="

# Test 8A: Missing IMAGE_PREFIX on non-kind context fails
MISSING_PREFIX_ERR="$("${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run 2>&1 || true)"
if echo "${MISSING_PREFIX_ERR}" | grep -q "error: IMAGE_PREFIX must be set when deploying to a non-kind cluster"; then
  echo "PASS: deploy-to-kube requires IMAGE_PREFIX on non-kind cluster."
else
  echo "FAIL: deploy-to-kube did not reject missing IMAGE_PREFIX on non-kind cluster. Got: ${MISSING_PREFIX_ERR}" >&2
  exit 1
fi

# Test 8B: Invalid --set syntax is rejected
INVALID_SET_ERR="$(IMAGE_PREFIX=test-prefix "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run --set invalid 2>&1 || true)"
if echo "${INVALID_SET_ERR}" | grep -q "error: --set expects KEY=VALUE, got 'invalid'"; then
  echo "PASS: deploy-to-kube rejects invalid --set syntax."
else
  echo "FAIL: deploy-to-kube did not reject invalid --set syntax. Got: ${INVALID_SET_ERR}" >&2
  exit 1
fi

# Test 8C: Kind context defaults to images.local, host platform, and SANDBOXD_TAG
cat << 'EOF' > "${MOCK_BIN}/kubectl"
#!/bin/sh
if [ "$1" = "config" ] && [ "$2" = "current-context" ]; then
  echo "kind-test-cluster"
  exit 0
fi
exit 0
EOF
chmod +x "${MOCK_BIN}/kubectl"

KIND_DRY_RUN="$(PATH="${MOCK_BIN}:${PATH}" "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run)"
if echo "${KIND_DRY_RUN}" | grep -q "sandboxdImage: images.local/sandboxd:${SANDBOXD_TAG}"; then
  echo "PASS: deploy-to-kube defaults IMAGE_PREFIX to images.local on kind cluster."
else
  echo "FAIL: deploy-to-kube did not default to images.local on kind cluster. Got: ${KIND_DRY_RUN}" >&2
  exit 1
fi

HOST_ARCH="$(uname -m)"
case "${HOST_ARCH}" in
  x86_64|amd64) EXPECTED_KIND_PLATFORM="linux/amd64" ;;
  aarch64|arm64) EXPECTED_KIND_PLATFORM="linux/arm64" ;;
  *) EXPECTED_KIND_PLATFORM="linux/${HOST_ARCH}" ;;
esac

if echo "${KIND_DRY_RUN}" | grep -q -- "--platform=${EXPECTED_KIND_PLATFORM}"; then
  echo "PASS: deploy-to-kube passes host platform ${EXPECTED_KIND_PLATFORM} on kind."
else
  echo "FAIL: deploy-to-kube did not pass host platform on kind. Got: ${KIND_DRY_RUN}" >&2
  exit 1
fi

# Test 8C.1: Kind context without kind on PATH fails fast
KIND_MISSING_ERR="$(DEPLOY_TO_KUBE_USE_BUILD_BIN=false PATH="${MOCK_BIN}:/usr/bin:/bin" "${REPO_ROOT}/dev/tasks/deploy-to-kube" 2>&1 || true)"
if echo "${KIND_MISSING_ERR}" | grep -q "error: kind is required on PATH when deploying to a kind cluster"; then
  echo "PASS: deploy-to-kube fails loudly when kind is not on PATH for kind cluster."
else
  echo "FAIL: deploy-to-kube did not fail when kind is not on PATH. Got: ${KIND_MISSING_ERR}" >&2
  exit 1
fi

# Test 8D: Dry run on non-kind cluster with --set and artifactBucket notice
rm -f "${MOCK_BIN}/kubectl"
NONKIND_DRY_RUN="$(IMAGE_PREFIX="gcr.io/test-project" "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run --set artifactBucket=my-bucket --set defaultModel=test-model)"
for expected in \
  "Ensuring namespaces eval-runner and eval-runner-sandbox" \
  "Installing agent-sandbox (${AGENT_SANDBOX_VERSION})" \
  "build-sandboxd --push" \
  "artifactBucket: my-bucket" \
  "sandboxdImage: gcr.io/test-project/sandboxd:${SANDBOXD_TAG}" \
  "roles/storage.objectAdmin granted on bucket gs://my-bucket" \
  "eval-runner-sandbox get secret model-credentials" \
  "dev/tasks/deploy --dry-run"; do
  if ! echo "${NONKIND_DRY_RUN}" | grep -q "${expected}"; then
    echo "FAIL: deploy-to-kube dry run missing expected line '${expected}'. Got: ${NONKIND_DRY_RUN}" >&2
    exit 1
  fi
done
echo "PASS: deploy-to-kube dry run executes all steps idempotently with expected configurations."

# Test 8E: --skip-sandboxd-build
SKIP_SANDBOXD_RUN="$(IMAGE_PREFIX="gcr.io/test-project" "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run --skip-sandboxd-build)"
if echo "${SKIP_SANDBOXD_RUN}" | grep -q -- "--skip-sandboxd-build: reusing existing image"; then
  echo "PASS: deploy-to-kube respects --skip-sandboxd-build."
else
  echo "FAIL: deploy-to-kube did not respect --skip-sandboxd-build. Got: ${SKIP_SANDBOXD_RUN}" >&2
  exit 1
fi

# Test 8F: --skip-deploy
SKIP_DEPLOY_RUN="$(IMAGE_PREFIX="gcr.io/test-project" "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run --skip-deploy)"
if echo "${SKIP_DEPLOY_RUN}" | grep -q "Deploy (skipped)"; then
  echo "PASS: deploy-to-kube respects --skip-deploy."
else
  echo "FAIL: deploy-to-kube did not respect --skip-deploy. Got: ${SKIP_DEPLOY_RUN}" >&2
  exit 1
fi

# Test 8G: --restart
RESTART_RUN="$(IMAGE_PREFIX="gcr.io/test-project" "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run --restart)"
if echo "${RESTART_RUN}" | grep -q "rollout restart deployment/eval-runner-controller"; then
  echo "PASS: deploy-to-kube respects --restart."
else
  echo "FAIL: deploy-to-kube did not respect --restart. Got: ${RESTART_RUN}" >&2
  exit 1
fi

# Test 8H: IMAGE_TAG in caller environment does not leak to build-sandboxd
TAG_ISOLATION_OUT="$(IMAGE_TAG="polluted-tag" IMAGE_PREFIX="gcr.io/test-project" "${REPO_ROOT}/dev/tasks/deploy-to-kube" --dry-run)"
if echo "${TAG_ISOLATION_OUT}" | grep -q "env IMAGE_TAG=${SANDBOXD_TAG} .*build-sandboxd"; then
  echo "PASS: deploy-to-kube passes IMAGE_TAG=\${SANDBOXD_TAG} to build-sandboxd when IMAGE_TAG is set in caller environment."
else
  echo "FAIL: deploy-to-kube did not isolate IMAGE_TAG for build-sandboxd. Got: ${TAG_ISOLATION_OUT}" >&2
  exit 1
fi

echo "=== 9. Testing dev/tasks/deploy-to-gke delegation to deploy-to-kube ==="
cat << 'EOF' > "${MOCK_BIN}/gcloud"
#!/bin/sh
if [ "$1" = "auth" ]; then echo "test-user@google.com"; exit 0; fi
if [ "$1" = "container" ] && [ "$2" = "clusters" ] && [ "$3" = "describe" ]; then
  echo '{"workloadIdentityConfig": {"workloadPool": "test-project.svc.id.goog"}}'
  exit 0
fi
if [ "$1" = "projects" ] && [ "$2" = "describe" ]; then echo "123456789"; exit 0; fi
if [ "$1" = "storage" ]; then exit 0; fi
exit 0
EOF
chmod +x "${MOCK_BIN}/gcloud"

GKE_DRY_RUN="$(PATH="${MOCK_BIN}:${PATH}" "${REPO_ROOT}/dev/tasks/deploy-to-gke" --cluster projects/test-project/locations/us-central1/clusters/test-cluster --dry-run 2>&1)"
if echo "${GKE_DRY_RUN}" | grep -q "deploy-to-kube --image-prefix=gcr.io/test-project"; then
  echo "PASS: dev/tasks/deploy-to-gke delegates to deploy-to-kube."
else
  echo "FAIL: dev/tasks/deploy-to-gke did not delegate to deploy-to-kube. Got: ${GKE_DRY_RUN}" >&2
  exit 1
fi

echo "=== All test-deploy checks passed successfully ==="
