set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Use tools from .build/bin if present
if [[ "${DEPLOY_TO_KUBE_USE_BUILD_BIN:-true}" == "true" && -d "${REPO_ROOT}/.build/bin" ]]; then
  export PATH="${PATH}:${REPO_ROOT}/.build/bin"
fi

export GOTOOLCHAIN=auto

# shellcheck source=dev/tasks/versions.sh
source "${REPO_ROOT}/dev/tasks/versions.sh"

IMAGE_PREFIX="${IMAGE_PREFIX:-}"
DRY_RUN=false
SKIP_SANDBOXD_BUILD=false
SKIP_DEPLOY=false
RESTART=false
SET_ITEMS=()

usage() {
  cat << 'EOF'
Usage: dev/tasks/deploy-to-kube [options]

Deploys eval-runner and its dependencies (agent-sandbox, sandboxd, ConfigMap)
to whatever kubeconfig/context is currently active.

Options:
  --image-prefix PREFIX      Container image registry prefix (e.g. gcr.io/my-project).
                             Required unless context is kind-* (defaults to images.local).
  --set KEY=VALUE            Extra eval-runner-config ConfigMap entries (repeatable),
                             e.g. --set artifactBucket=my-bucket --set defaultModel=gemini-2.5-flash
  --skip-sandboxd-build      Skip building and pushing sandboxd; reuse an existing image.
  --skip-deploy              Provision dependencies and ConfigMap only; do not run dev/tasks/deploy.
  --restart                  Restart controller/UI/webhook deployments after deploy.
  --dry-run                  Print commands without executing mutating actions.
  -h, --help                 Show this help message.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image-prefix)
      IMAGE_PREFIX="$2"
      shift 2
      ;;
    --image-prefix=*)
      IMAGE_PREFIX="${1#*=}"
      shift
      ;;
    --set)
      SET_ITEMS+=("$2")
      shift 2
      ;;
    --set=*)
      SET_ITEMS+=("${1#*=}")
      shift
      ;;
    --skip-sandboxd-build)
      SKIP_SANDBOXD_BUILD=true
      shift
      ;;
    --skip-deploy)
      SKIP_DEPLOY=true
      shift
      ;;
    --restart)
      RESTART=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

for item in "${SET_ITEMS[@]+"${SET_ITEMS[@]}"}"; do
  if [[ "${item}" != *"="* ]]; then
    echo "error: --set expects KEY=VALUE, got '${item}'" >&2
    exit 1
  fi
done

CURRENT_CONTEXT="$(kubectl config current-context 2>/dev/null || echo "")"

IS_KIND=false
KIND_CLUSTER_NAME=""
if [[ "${CURRENT_CONTEXT}" == kind-* ]]; then
  IS_KIND=true
  KIND_CLUSTER_NAME="${CURRENT_CONTEXT#kind-}"
fi

if [[ "${IS_KIND}" == "true" ]]; then
  IMAGE_PREFIX="${IMAGE_PREFIX:-images.local}"
  export IMAGE_TAG="${IMAGE_TAG:-dev}"
else
  if [[ -z "${IMAGE_PREFIX}" ]]; then
    echo "error: IMAGE_PREFIX must be set when deploying to a non-kind cluster (e.g. IMAGE_PREFIX=gcr.io/my-project)" >&2
    exit 1
  fi
fi
export IMAGE_PREFIX

STEP_NUM=0
step() {
  STEP_NUM=$((STEP_NUM + 1))
  echo ""
  echo "==> [${STEP_NUM}] $1"
}

run_cmd() {
  echo "    $ $*"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  "$@"
}

run_cmd_stdin() {
  local stdin_data="$1"
  shift
  echo "    $ $*"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  printf '%s' "${stdin_data}" | "$@"
}

wait_for_effective_settings() {
  local bucket="$1"
  local since_time="$2"
  local timeout=60
  local deadline=$(( $(date +%s) + timeout ))
  local cmd=(kubectl -n eval-runner logs deployment/eval-runner-controller)
  if [[ -n "${since_time}" ]]; then
    cmd+=(--since-time="${since_time}")
  fi

  echo "    waiting up to ${timeout}s for controller to log effective cluster settings..."
  while [[ $(date +%s) -lt ${deadline} ]]; do
    local logs=""
    if logs="$("${cmd[@]}" 2>/dev/null)"; then
      if [[ -n "${logs}" ]]; then
        local match=""
        while IFS= read -r line; do
          if [[ "${line}" == *"effective cluster settings"* ]]; then
            if [[ -z "${bucket}" || "${line}" == *"${bucket}"* ]]; then
              match="${line}"
            fi
          fi
        done <<< "${logs}"

        if [[ -n "${match}" ]]; then
          echo "    ${match}"
          return 0
        fi
      fi
    fi
    sleep 2
  done

  local desc=""
  if [[ -n "${bucket}" ]]; then
    desc=" reflecting artifactBucket=${bucket}"
  fi
  echo "    WARNING: did not see 'effective cluster settings'${desc} within ${timeout}s;"
  echo "    the deploy succeeded. Check with: kubectl -n eval-runner logs deployment/eval-runner-controller | grep 'effective cluster settings'"
}

if [[ "${DRY_RUN}" == "true" ]]; then
  echo "dry run: mutating commands are printed, not executed"
fi

# Step 1: Ensure namespaces
step "Ensuring namespaces eval-runner and eval-runner-sandbox"
run_cmd kubectl apply -f "${REPO_ROOT}/k8s/00-namespaces.yaml"

# Step 2: Install agent-sandbox at pinned release
step "Installing agent-sandbox (${AGENT_SANDBOX_VERSION})"
AGENT_SANDBOX_URL="https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/sandbox.yaml"
run_cmd kubectl apply -f "${AGENT_SANDBOX_URL}"
run_cmd kubectl wait --for=condition=Established crd/sandboxes.agents.x-k8s.io --timeout=60s
run_cmd kubectl -n agent-sandbox-system rollout status deployment/agent-sandbox-controller --timeout=120s

# Step 3: Sandboxd image
step "Sandboxd image (${SANDBOXD_TAG})"
DEFAULT_SANDBOXD_IMAGE="${IMAGE_PREFIX}/sandboxd:${SANDBOXD_TAG}"
if [[ "${SKIP_SANDBOXD_BUILD}" == "true" ]]; then
  echo "    --skip-sandboxd-build: reusing existing image ${DEFAULT_SANDBOXD_IMAGE}"
else
  if [[ "${IS_KIND}" == "true" ]]; then
    if ! command -v kind >/dev/null 2>&1 && [[ "${DRY_RUN}" != "true" ]]; then
      echo "error: kind is required on PATH when deploying to a kind cluster" >&2
      exit 1
    fi
    HOST_ARCH="$(uname -m)"
    case "${HOST_ARCH}" in
      x86_64|amd64) KIND_PLATFORM="linux/amd64" ;;
      aarch64|arm64) KIND_PLATFORM="linux/arm64" ;;
      *) KIND_PLATFORM="linux/${HOST_ARCH}" ;;
    esac
    run_cmd env IMAGE_TAG="${SANDBOXD_TAG}" "${REPO_ROOT}/dev/tasks/build-sandboxd" "--platform=${KIND_PLATFORM}"
    run_cmd kind load docker-image "${DEFAULT_SANDBOXD_IMAGE}" --name "${KIND_CLUSTER_NAME}"
  else
    run_cmd env IMAGE_TAG="${SANDBOXD_TAG}" "${REPO_ROOT}/dev/tasks/build-sandboxd" --push
  fi
fi

# Step 4: eval-runner-config ConfigMap
step "ConfigMap eval-runner/eval-runner-config"
CONFIGMAP_CHANGED="false"

DESIRED_JSON="$(python3 -c '
import json, sys

desired = {"sandboxdImage": sys.argv[1]}
for item in sys.argv[2:]:
    if "=" in item:
        k, v = item.split("=", 1)
        desired[k.strip()] = v
print(json.dumps(desired))
' "${DEFAULT_SANDBOXD_IMAGE}" "${SET_ITEMS[@]+"${SET_ITEMS[@]}"}")"

ARTIFACT_BUCKET="$(python3 -c '
import json, sys
data = json.loads(sys.argv[1])
print(data.get("artifactBucket", ""))
' "${DESIRED_JSON}")"

if [[ -n "${ARTIFACT_BUCKET}" ]]; then
  echo "    Artifact bucket: gs://${ARTIFACT_BUCKET}"
  echo "    Note: The controller and UI use Application Default Credentials (ADC) for bucket access."
  echo "    On non-GKE clusters, ensure the node service account (or equivalent IAM provider) has"
  echo "    roles/storage.objectAdmin granted on bucket gs://${ARTIFACT_BUCKET}."
fi

if [[ "${DRY_RUN}" == "true" ]]; then
  MANIFEST_JSON="$(python3 -c '
import json, sys
desired = json.loads(sys.argv[1])
manifest = {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {"name": "eval-runner-config", "namespace": "eval-runner"},
    "data": desired,
}
print(json.dumps(manifest, indent=2))
' "${DESIRED_JSON}")"
  run_cmd_stdin "${MANIFEST_JSON}" kubectl apply -f -
  python3 -c '
import json, sys
desired = json.loads(sys.argv[1])
for k, v in sorted(desired.items()):
    print(f"    {k}: {v}")
' "${DESIRED_JSON}"
else
  EXISTING_RAW="$(kubectl -n eval-runner get configmap eval-runner-config -o json 2>/dev/null || echo "")"
  MERGE_RESULT="$(python3 -c '
import json, sys

existing_raw = sys.argv[1].strip()
desired = json.loads(sys.argv[2])

data = {}
if existing_raw:
    try:
        data = json.loads(existing_raw).get("data") or {}
    except Exception:
        data = {}

merged = dict(data)
merged.update(desired)

changed = (merged != data)
manifest = {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {"name": "eval-runner-config", "namespace": "eval-runner"},
    "data": merged,
}
print("CHANGED" if changed else "UNCHANGED")
print(json.dumps(manifest))
' "${EXISTING_RAW}" "${DESIRED_JSON}")"

  STATUS="$(echo "${MERGE_RESULT}" | head -n 1)"
  MANIFEST="$(echo "${MERGE_RESULT}" | tail -n +2)"

  if [[ "${STATUS}" == "CHANGED" ]]; then
    CONFIGMAP_CHANGED="true"
    printf '%s' "${MANIFEST}" | kubectl apply -f -
    python3 -c '
import json, sys
desired = json.loads(sys.argv[1])
for k, v in sorted(desired.items()):
    print(f"    {k}: {v}")
' "${DESIRED_JSON}"
  else
    echo "    configmap eval-runner/eval-runner-config already up to date"
  fi
fi

# Step 5: Check model credentials
step "Model credentials"
if [[ "${DRY_RUN}" == "true" ]]; then
  run_cmd kubectl -n eval-runner-sandbox get secret model-credentials -o name
else
  if kubectl -n eval-runner-sandbox get secret model-credentials -o name >/dev/null 2>&1; then
    echo "    secret eval-runner-sandbox/model-credentials present"
  else
    echo "    secret eval-runner-sandbox/model-credentials is MISSING. Sandboxes read model API keys from it."
    echo "    Create it with the keys your evals need, for example:"
    echo "      kubectl -n eval-runner-sandbox create secret generic model-credentials \\"
    echo "        --from-literal=GOOGLE_API_KEY=<key>"
    echo "    (see docs/development.md, 'Running Sample Evaluations with a Real Model')."
  fi
fi

# Step 6: Deploy manifests and images
if [[ "${SKIP_DEPLOY}" == "true" ]]; then
  step "Deploy (skipped)"
  echo "    --skip-deploy: run later with: IMAGE_PREFIX=${IMAGE_PREFIX} ./dev/tasks/deploy"
else
  step "Deploy images ${IMAGE_PREFIX}/* and manifests"
  STARTED_TIME="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  if [[ "${DRY_RUN}" == "true" ]]; then
    run_cmd "${REPO_ROOT}/dev/tasks/deploy" --dry-run
    if [[ "${RESTART}" == "true" ]]; then
      for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
        run_cmd kubectl -n eval-runner rollout restart "deployment/${d}"
      done
    fi
    for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
      run_cmd kubectl -n eval-runner rollout status "deployment/${d}" --timeout=300s
    done
    run_cmd kubectl -n eval-runner logs deployment/eval-runner-controller --since-time="${STARTED_TIME}"
  else
    "${REPO_ROOT}/dev/tasks/deploy"
    if [[ "${RESTART}" == "true" ]]; then
      for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
        kubectl -n eval-runner rollout restart "deployment/${d}"
      done
    fi
    for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
      kubectl -n eval-runner rollout status "deployment/${d}" --timeout=300s
    done

    SINCE_ARG=""
    if [[ "${CONFIGMAP_CHANGED}" == "true" ]]; then
      SINCE_ARG="${STARTED_TIME}"
    fi
    wait_for_effective_settings "${ARTIFACT_BUCKET}" "${SINCE_ARG}"
  fi
fi

# Done
step "Done"
echo "    kubectl -n eval-runner get runs,comparisons"
echo "    kubectl -n eval-runner port-forward svc/eval-runner-ui 8080:80   # then open http://localhost:8080/"
echo "    Next: expose the UI behind your own ingress or gateway, and set uiBaseURL in the ConfigMap"
echo "    (--set uiBaseURL=https://...) so PR comments link back to it."
