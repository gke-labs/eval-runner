set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Use tools from .build/bin if present
if [[ "${DEPLOY_TO_KUBE_USE_BUILD_BIN:-true}" == "true" && -d "${REPO_ROOT}/.build/bin" ]]; then
  export PATH="${PATH}:${REPO_ROOT}/.build/bin"
fi

export GOTOOLCHAIN=auto

# shellcheck source=dev/tasks/versions.sh
source "${REPO_ROOT}/dev/tasks/versions.sh"

IMAGE_PREFIX="${IMAGE_PREFIX:-}"
GATEWAY_NAME="${GATEWAY_NAME:-hello-gw}"
GATEWAY_NAMESPACE="${GATEWAY_NAMESPACE:-default}"
DRY_RUN=false
SKIP_SANDBOXD_BUILD=false
SKIP_SAMPLE_RUNNER_BUILD=false
SKIP_SERVICE_PORTAL=false
SKIP_DEPLOY=false
RESTART=false
SET_ITEMS=()

usage() {
  cat << 'EOF'
Usage: dev/tasks/deploy-to-kube [options]

Deploys eval-runner and its dependencies (agent-sandbox, sandboxd, ConfigMap)
to whatever kubeconfig/context is currently active.

Options:
  --image-prefix PREFIX      Container image registry prefix (e.g. gcr.io/my-project).
                             Required unless context is kind-* (defaults to images.local).
  --gateway-name NAME        Gateway parentRef name for HTTPRoute (defaults to hello-gw).
  --gateway-namespace NS     Gateway namespace for HTTPRoute (defaults to default).
  --set KEY=VALUE            Extra eval-runner-config ConfigMap entries (repeatable),
                             e.g. --set artifactBucket=my-bucket --set defaultModel=gemini-2.5-flash
  --skip-sandboxd-build      Skip building and pushing sandboxd; reuse an existing image.
  --skip-sample-runner-build Skip building and loading sample-runner; reuse an existing image.
  --skip-service-portal      Skip deploying the service portal (NRI agent and controller).
  --skip-deploy              Provision dependencies and ConfigMap only; do not run dev/tasks/deploy.
  --restart                  Restart controller/UI/webhook deployments after deploy.
  --dry-run                  Print commands without executing mutating actions.
  -h, --help                 Show this help message.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image-prefix)
      IMAGE_PREFIX="$2"
      shift 2
      ;;
    --image-prefix=*)
      IMAGE_PREFIX="${1#*=}"
      shift
      ;;
    --gateway-name)
      GATEWAY_NAME="$2"
      shift 2
      ;;
    --gateway-name=*)
      GATEWAY_NAME="${1#*=}"
      shift
      ;;
    --gateway-namespace)
      GATEWAY_NAMESPACE="$2"
      shift 2
      ;;
    --gateway-namespace=*)
      GATEWAY_NAMESPACE="${1#*=}"
      shift
      ;;
    --set)
      SET_ITEMS+=("$2")
      shift 2
      ;;
    --set=*)
      SET_ITEMS+=("${1#*=}")
      shift
      ;;
    --skip-sandboxd-build)
      SKIP_SANDBOXD_BUILD=true
      shift
      ;;
    --skip-sample-runner-build)
      SKIP_SAMPLE_RUNNER_BUILD=true
      shift
      ;;
    --skip-service-portal)
      SKIP_SERVICE_PORTAL=true
      shift
      ;;
    --skip-deploy)
      SKIP_DEPLOY=true
      shift
      ;;
    --restart)
      RESTART=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

for item in "${SET_ITEMS[@]+"${SET_ITEMS[@]}"}"; do
  if [[ "${item}" != *"="* ]]; then
    echo "error: --set expects KEY=VALUE, got '${item}'" >&2
    exit 1
  fi
done

CURRENT_CONTEXT="$(kubectl config current-context 2>/dev/null || echo "")"

IS_KIND=false
KIND_CLUSTER_NAME=""
if [[ "${CURRENT_CONTEXT}" == kind-* ]]; then
  IS_KIND=true
  KIND_CLUSTER_NAME="${CURRENT_CONTEXT#kind-}"
fi

if [[ "${IS_KIND}" == "true" ]]; then
  unset KUBERNETES_SERVICE_HOST KUBERNETES_SERVICE_PORT
  IMAGE_PREFIX="${IMAGE_PREFIX:-images.local}"
  export IMAGE_TAG="${IMAGE_TAG:-dev}"
else
  if [[ -z "${IMAGE_PREFIX}" ]]; then
    echo "error: IMAGE_PREFIX must be set when deploying to a non-kind cluster (e.g. IMAGE_PREFIX=gcr.io/my-project)" >&2
    exit 1
  fi
  export IMAGE_TAG="${IMAGE_TAG:-${DEFAULT_IMAGE_TAG}}"
fi
export IMAGE_PREFIX

STEP_NUM=0
step() {
  STEP_NUM=$((STEP_NUM + 1))
  echo ""
  echo "==> [${STEP_NUM}] $1"
}

run_cmd() {
  echo "    $ $*"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  "$@"
}

run_cmd_stdin() {
  local stdin_data="$1"
  shift
  echo "    $ $*"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  printf '%s' "${stdin_data}" | "$@"
}

wait_for_effective_settings() {
  local bucket="$1"
  local since_time="$2"
  local timeoutSeconds=60
  local deadline=$(( $(date +%s) + timeoutSeconds ))
  local cmd=(kubectl -n eval-runner logs deployment/eval-runner-controller)
  if [[ -n "${since_time}" ]]; then
    cmd+=(--since-time="${since_time}")
  fi

  echo "    waiting up to ${timeoutSeconds}s for controller to log effective cluster settings..."
  while [[ $(date +%s) -lt ${deadline} ]]; do
    local logs=""
    if logs="$("${cmd[@]}" 2>/dev/null)"; then
      if [[ -n "${logs}" ]]; then
        local match=""
        while IFS= read -r line; do
          if [[ "${line}" == *"effective cluster settings"* ]]; then
            if [[ -z "${bucket}" || "${line}" == *"${bucket}"* ]]; then
              match="${line}"
            fi
          fi
        done <<< "${logs}"

        if [[ -n "${match}" ]]; then
          echo "    ${match}"
          return 0
        fi
      fi
    fi
    sleep 2
  done

  local desc=""
  if [[ -n "${bucket}" ]]; then
    desc=" reflecting artifactBucket=${bucket}"
  fi
  echo "    WARNING: did not see 'effective cluster settings'${desc} within ${timeoutSeconds}s;"
  echo "    the deploy succeeded. Check with: kubectl -n eval-runner logs deployment/eval-runner-controller | grep 'effective cluster settings'"
}

ensure_cached_repo() {
  local repo_name="$1"
  local repo_url="$2"
  local commit="$3"
  local cache_base="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/eval-runner"
  local target_dir="${cache_base}/${repo_name}/${commit}"

  if [[ -d "${target_dir}/.git" ]]; then
    local current_commit
    current_commit="$(git -C "${target_dir}" rev-parse HEAD 2>/dev/null || true)"
    if [[ "${current_commit}" == "${commit}"* ]]; then
      echo "${target_dir}"
      return 0
    fi
  fi

  echo "    cloning ${repo_name} at ref ${commit}..." >&2
  mkdir -p "$(dirname "${target_dir}")"
  if [[ ! -d "${target_dir}/.git" ]]; then
    git clone "${repo_url}" "${target_dir}" >&2
  fi
  git -C "${target_dir}" fetch origin >&2
  git -C "${target_dir}" checkout "${commit}" >&2
  echo "${target_dir}"
}

if [[ "${DRY_RUN}" == "true" ]]; then
  echo "dry run: mutating commands are printed, not executed"
fi

# Step 1: Ensure namespaces
step "Ensuring namespaces eval-runner and eval-runner-sandbox"
run_cmd kubectl apply -f "${REPO_ROOT}/k8s/00-namespaces.yaml"

# Step 2: Install agent-sandbox at pinned release
step "Installing agent-sandbox (${AGENT_SANDBOX_VERSION})"
AGENT_SANDBOX_URL="https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/sandbox.yaml"
run_cmd kubectl apply -f "${AGENT_SANDBOX_URL}"
run_cmd kubectl wait --for=condition=Established crd/sandboxes.agents.x-k8s.io --timeout=60s
run_cmd kubectl -n agent-sandbox-system rollout status deployment/agent-sandbox-controller --timeout=120s

GATEWAY_API_URL="https://github.com/kubernetes-sigs/gateway-api/releases/download/${GATEWAY_API_VERSION}/standard-install.yaml"
if [[ "${DRY_RUN}" == "true" ]] || ! kubectl get crd httproutes.gateway.networking.k8s.io >/dev/null 2>&1; then
  step "Installing Gateway API CRDs (${GATEWAY_API_VERSION})"
  run_cmd kubectl apply -f "${GATEWAY_API_URL}"
  run_cmd kubectl wait --for=condition=Established crd/httproutes.gateway.networking.k8s.io --timeout=60s
  run_cmd kubectl wait --for=condition=Established crd/referencegrants.gateway.networking.k8s.io --timeout=60s
fi

# Step 3: Sandboxd image
step "Sandboxd image (${SANDBOXD_TAG})"
DEFAULT_SANDBOXD_IMAGE="${IMAGE_PREFIX}/sandboxd:${SANDBOXD_TAG}"
if [[ "${SKIP_SANDBOXD_BUILD}" == "true" ]]; then
  echo "    --skip-sandboxd-build: reusing existing image ${DEFAULT_SANDBOXD_IMAGE}"
else
  if [[ "${IS_KIND}" == "true" ]]; then
    if ! command -v kind >/dev/null 2>&1 && [[ "${DRY_RUN}" != "true" ]]; then
      echo "error: kind is required on PATH when deploying to a kind cluster" >&2
      exit 1
    fi
    HOST_ARCH="$(uname -m)"
    case "${HOST_ARCH}" in
      x86_64|amd64) KIND_PLATFORM="linux/amd64" ;;
      aarch64|arm64) KIND_PLATFORM="linux/arm64" ;;
      *) KIND_PLATFORM="linux/${HOST_ARCH}" ;;
    esac
    run_cmd env IMAGE_TAG="${SANDBOXD_TAG}" "${REPO_ROOT}/dev/tasks/sandboxd-image" "--platform=${KIND_PLATFORM}"
    run_cmd kind load docker-image "${DEFAULT_SANDBOXD_IMAGE}" --name "${KIND_CLUSTER_NAME}"
  else
    run_cmd env IMAGE_TAG="${SANDBOXD_TAG}" "${REPO_ROOT}/dev/tasks/sandboxd-image" --push
  fi
fi

# Step 3b: Sample-runner image
SAMPLE_RUNNER_IMAGE="${IMAGE_PREFIX}/sample-runner:${IMAGE_TAG}"
if [[ "${SKIP_SAMPLE_RUNNER_BUILD}" == "true" ]]; then
  echo "    --skip-sample-runner-build: reusing existing image ${SAMPLE_RUNNER_IMAGE}"
else
  if [[ "${IS_KIND}" == "true" ]]; then
    step "Sample-runner image (${SAMPLE_RUNNER_IMAGE})"
    run_cmd "${DOCKER:-docker}" build -t "${SAMPLE_RUNNER_IMAGE}" -f "${REPO_ROOT}/images/sample-runner/Dockerfile" "${REPO_ROOT}/images/sample-runner"
    run_cmd kind load docker-image "${SAMPLE_RUNNER_IMAGE}" --name "${KIND_CLUSTER_NAME}"
  fi
fi

# Step 4: eval-runner-config ConfigMap
step "ConfigMap eval-runner/eval-runner-config"
CONFIGMAP_CHANGED="false"

EXISTING_RAW="$(kubectl -n eval-runner get configmap eval-runner-config -o json 2>/dev/null || echo "")"
MERGE_RESULT="$(python3 -c '
import json, sys

existing_raw = sys.argv[1].strip()
default_sandboxd_image = sys.argv[2]
skip_service_portal = (sys.argv[3].lower() == "true")
set_items = sys.argv[4:]

data = {}
if existing_raw:
    try:
        data = json.loads(existing_raw).get("data") or {}
    except Exception:
        data = {}

user_overrides = {}
for item in set_items:
    if "=" in item:
        k, v = item.split("=", 1)
        user_overrides[k.strip()] = v

merged = dict(data)

service_portal_keys = ("servicePortalControllerAddress", "servicePortalControllerCAFile", "servicePortalTokenFile")
service_portal_defaults = {
    "servicePortalControllerAddress": "service-portal-controller.service-portal-system.svc:8443",
    "servicePortalControllerCAFile": "/etc/service-portal/tls.crt",
    "servicePortalTokenFile": "/var/run/secrets/service-portal/token",
}
if skip_service_portal:
    if merged.get("servicePortalControllerAddress") == service_portal_defaults["servicePortalControllerAddress"]:
        for k in service_portal_keys:
            if k not in user_overrides:
                merged.pop(k, None)
else:
    for k, v in service_portal_defaults.items():
        if k not in merged:
            merged[k] = v

if "sandboxdImage" not in user_overrides:
    merged["sandboxdImage"] = default_sandboxd_image

merged.update(user_overrides)

changed = (merged != data)
manifest = {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {"name": "eval-runner-config", "namespace": "eval-runner"},
    "data": merged,
}
print("CHANGED" if changed else "UNCHANGED")
print(json.dumps(manifest))
' "${EXISTING_RAW}" "${DEFAULT_SANDBOXD_IMAGE}" "${SKIP_SERVICE_PORTAL}" "${SET_ITEMS[@]+"${SET_ITEMS[@]}"}")"

STATUS="$(echo "${MERGE_RESULT}" | head -n 1)"
MANIFEST="$(echo "${MERGE_RESULT}" | tail -n +2)"

ARTIFACT_BUCKET="$(python3 -c '
import json, sys
data = json.loads(sys.argv[1]).get("data") or {}
print(data.get("artifactBucket", ""))
' "${MANIFEST}")"

if [[ -n "${ARTIFACT_BUCKET}" ]]; then
  echo "    Artifact bucket: gs://${ARTIFACT_BUCKET}"
  echo "    Note: The controller and UI use Application Default Credentials (ADC) for bucket access."
  echo "    On non-GKE clusters, ensure the node service account (or equivalent IAM provider) has"
  echo "    roles/storage.objectAdmin granted on bucket gs://${ARTIFACT_BUCKET}."
fi

if [[ "${DRY_RUN}" == "true" ]]; then
  run_cmd_stdin "${MANIFEST}" kubectl apply -f -
  python3 -c '
import json, sys
data = json.loads(sys.argv[1]).get("data") or {}
for k, v in sorted(data.items()):
    print(f"    {k}: {v}")
' "${MANIFEST}"
else
  if [[ "${STATUS}" == "CHANGED" ]]; then
    CONFIGMAP_CHANGED="true"
    printf '%s' "${MANIFEST}" | kubectl apply -f -
    python3 -c '
import json, sys
data = json.loads(sys.argv[1]).get("data") or {}
for k, v in sorted(data.items()):
    print(f"    {k}: {v}")
' "${MANIFEST}"
  else
    echo "    configmap eval-runner/eval-runner-config already up to date"
  fi
fi

# Step 5: Check model credentials
step "Model credentials"
if [[ "${DRY_RUN}" == "true" ]]; then
  run_cmd kubectl -n eval-runner get secret model-credentials -o name
else
  if kubectl -n eval-runner get secret model-credentials -o name >/dev/null 2>&1; then
    echo "    secret eval-runner/model-credentials present"
  else
    echo "    secret eval-runner/model-credentials is MISSING. Controller reads GEMINI_API_KEY from it for agent tasks."
    echo "    Create it with the keys your evals need, for example:"
    echo "      kubectl -n eval-runner create secret generic model-credentials \\"
    echo "        --from-literal=GEMINI_API_KEY=<key>"
    echo "    (see docs/development.md, 'Running Agent Tasks with a Real Model')."
  fi
fi

# Step 6: Service portal TLS certificates
SERVICE_PORTAL_CERTS_GENERATED=false
if [[ "${SKIP_SERVICE_PORTAL}" == "true" ]]; then
  step "Service portal TLS certificates (skipped)"
elif [[ "${DRY_RUN}" == "true" ]]; then
  step "Service portal TLS certificates"
  run_cmd kubectl get secret service-portal-controller-tls -n service-portal-system
  run_cmd kubectl get secret service-portal-controller-ca -n service-portal-system
  run_cmd kubectl get secret service-portal-controller-ca -n eval-runner
else
  step "Service portal TLS certificates"
  kubectl create namespace service-portal-system --dry-run=client -o yaml | kubectl apply -f -
  kubectl label namespace service-portal-system pod-security.kubernetes.io/enforce=privileged --overwrite

  if ! kubectl get secret service-portal-controller-tls -n service-portal-system >/dev/null 2>&1 || \
     ! kubectl get secret service-portal-controller-ca -n service-portal-system >/dev/null 2>&1; then
    echo "    generating throwaway CA and server certificate for service-portal-controller..."
    CERT_TMPDIR="$(mktemp -d)"
    openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout "${CERT_TMPDIR}/ca.key" -out "${CERT_TMPDIR}/ca.crt" -days 365 \
      -subj "/CN=service-portal-ca" 2>/dev/null

    openssl req -newkey rsa:2048 -nodes \
      -keyout "${CERT_TMPDIR}/tls.key" -out "${CERT_TMPDIR}/server.csr" \
      -subj "/CN=service-portal-controller" 2>/dev/null

    cat << 'EOF' > "${CERT_TMPDIR}/extfile.cnf"
subjectAltName = DNS:service-portal-controller,DNS:service-portal-controller.service-portal-system,DNS:service-portal-controller.service-portal-system.svc,DNS:service-portal-controller.service-portal-system.svc.cluster.local,DNS:localhost,IP:127.0.0.1
EOF

    openssl x509 -req -in "${CERT_TMPDIR}/server.csr" \
      -CA "${CERT_TMPDIR}/ca.crt" -CAkey "${CERT_TMPDIR}/ca.key" -CAcreateserial \
      -out "${CERT_TMPDIR}/tls.crt" -days 365 -extfile "${CERT_TMPDIR}/extfile.cnf" 2>/dev/null

    kubectl create secret tls service-portal-controller-tls \
      --cert="${CERT_TMPDIR}/tls.crt" --key="${CERT_TMPDIR}/tls.key" \
      -n service-portal-system --dry-run=client -o yaml | kubectl apply -f -

    kubectl create secret generic service-portal-controller-ca \
      --from-file=tls.crt="${CERT_TMPDIR}/ca.crt" \
      -n service-portal-system --dry-run=client -o yaml | kubectl apply -f -

    kubectl create secret generic service-portal-controller-ca \
      --from-file=tls.crt="${CERT_TMPDIR}/ca.crt" \
      -n eval-runner --dry-run=client -o yaml | kubectl apply -f -

    rm -rf "${CERT_TMPDIR}"
    SERVICE_PORTAL_CERTS_GENERATED=true
  else
    echo "    secrets service-portal-controller-tls and service-portal-controller-ca present in service-portal-system"
  fi

  if ! kubectl get secret service-portal-controller-ca -n eval-runner >/dev/null 2>&1; then
    echo "    copying service-portal-controller-ca secret to eval-runner namespace..."
    CA_CERT="$(kubectl get secret service-portal-controller-ca -n service-portal-system -o jsonpath='{.data.tls\.crt}' | base64 -d)"
    kubectl create secret generic service-portal-controller-ca \
      --from-literal=tls.crt="${CA_CERT}" \
      -n eval-runner --dry-run=client -o yaml | kubectl apply -f -
  fi
fi

# Step 7: Service portal deployment
if [[ "${SKIP_SERVICE_PORTAL}" == "true" ]]; then
  step "Service portal deployment (skipped)"
else
  step "Service portal deployment (${SERVICE_PORTALS_COMMIT})"

  if [[ -n "${SERVICE_PORTALS_DIR:-}" ]]; then
    OVERRIDE_COMMIT="$(git -C "${SERVICE_PORTALS_DIR}" rev-parse HEAD 2>/dev/null || echo "unknown")"
    echo "    using SERVICE_PORTALS_DIR override at commit ${OVERRIDE_COMMIT} (${SERVICE_PORTALS_DIR})"
  else
    SERVICE_PORTALS_DIR="$(ensure_cached_repo "service-portals" "https://github.com/gke-labs/service-portals.git" "${SERVICE_PORTALS_COMMIT}")"
  fi

  PARENT_DIR="$(cd "$(dirname "${SERVICE_PORTALS_DIR}")" 2>/dev/null && pwd || true)"
  RESOLVED_DIR="${PARENT_DIR}/$(basename "${SERVICE_PORTALS_DIR}")"
  if [[ "${RESOLVED_DIR}" == "${REPO_ROOT}"* ]]; then
    echo "ERROR: SERVICE_PORTALS_DIR (${RESOLVED_DIR}) is inside REPO_ROOT (${REPO_ROOT})." >&2
    exit 1
  fi

  SERVICE_PORTALS_DEPLOY_ARGS=()
  if [[ "${IS_KIND}" == "true" ]]; then
    SERVICE_PORTALS_DEPLOY_ARGS+=(--skip-push)
  fi

  if [[ "${DRY_RUN}" == "true" ]]; then
    run_cmd "${SERVICE_PORTALS_DIR}/dev/tasks/configure" --client-allowlist=system:serviceaccount:eval-runner:eval-runner-controller
    (cd "${SERVICE_PORTALS_DIR}" && run_cmd "${AP_CMD[@]}" deploy --dry-run "${SERVICE_PORTALS_DEPLOY_ARGS[@]+"${SERVICE_PORTALS_DEPLOY_ARGS[@]}"}" k8s/controller.yaml k8s/node-agent.yaml)
    if [[ "${RESTART}" == "true" || "${SERVICE_PORTAL_CERTS_GENERATED}" == "true" ]]; then
      run_cmd kubectl -n service-portal-system rollout restart deployment/service-portal-controller
      run_cmd kubectl -n service-portal-system rollout restart daemonset/portal-node-agent
    fi
    run_cmd kubectl -n service-portal-system rollout status deployment/service-portal-controller --timeout=300s
    run_cmd kubectl -n service-portal-system rollout status daemonset/portal-node-agent --timeout=300s
  else
    "${SERVICE_PORTALS_DIR}/dev/tasks/configure" --client-allowlist=system:serviceaccount:eval-runner:eval-runner-controller
    (cd "${SERVICE_PORTALS_DIR}" && "${AP_CMD[@]}" deploy "${SERVICE_PORTALS_DEPLOY_ARGS[@]+"${SERVICE_PORTALS_DEPLOY_ARGS[@]}"}" k8s/controller.yaml k8s/node-agent.yaml)

    if [[ "${RESTART}" == "true" || "${SERVICE_PORTAL_CERTS_GENERATED}" == "true" ]]; then
      kubectl -n service-portal-system rollout restart deployment/service-portal-controller
      kubectl -n service-portal-system rollout restart daemonset/portal-node-agent
    fi
    kubectl -n service-portal-system rollout status deployment/service-portal-controller --timeout=300s
    kubectl -n service-portal-system rollout status daemonset/portal-node-agent --timeout=300s

    echo "    waiting up to 60s for service portal node agent stream to connect to service-portal-controller..."
    DEADLINE=$(( $(date +%s) + 60 ))
    SERVICE_PORTAL_STREAM_CONNECTED=false
    while [[ $(date +%s) -lt ${DEADLINE} ]]; do
      CONTROLLER_LOGS="$(kubectl -n service-portal-system logs deployment/service-portal-controller --tail=1000 2>/dev/null || true)"
      NODE_AGENT_LOGS="$(kubectl -n service-portal-system logs daemonset/portal-node-agent -c proxy --tail=1000 2>/dev/null || true)"
      if echo "${CONTROLLER_LOGS}" | grep -q "node stream connected" || echo "${NODE_AGENT_LOGS}" | grep -q "controller: stream connected"; then
        SERVICE_PORTAL_STREAM_CONNECTED=true
        echo "    service portal node agent stream connected to controller"
        break
      fi
      sleep 2
    done
    if [[ "${SERVICE_PORTAL_STREAM_CONNECTED}" != "true" ]]; then
      echo "ERROR: service portal node agent stream to service-portal-controller did not connect within 60s" >&2
      echo "--- Last controller logs ---" >&2
      kubectl -n service-portal-system logs deployment/service-portal-controller --tail=50 >&2 || true
      echo "--- Last node agent proxy logs ---" >&2
      kubectl -n service-portal-system logs daemonset/portal-node-agent -c proxy --tail=50 >&2 || true
      exit 1
    fi
  fi
fi

# Step 8: Deploy manifests and images
if [[ "${SKIP_DEPLOY}" == "true" ]]; then
  step "Deploy (skipped)"
  echo "    --skip-deploy: run later with: IMAGE_PREFIX=${IMAGE_PREFIX} ./dev/tasks/deploy"
else
  step "Deploy images ${IMAGE_PREFIX}/* and manifests"
  STARTED_TIME="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  DEPLOY_ARGS=()
  if [[ "${IS_KIND}" == "true" ]]; then
    DEPLOY_ARGS+=(--skip-push)
  fi

  CONTROLLER_NEEDS_RESTART=false
  if [[ "${CONFIGMAP_CHANGED}" == "true" || "${SERVICE_PORTAL_CERTS_GENERATED}" == "true" ]]; then
    CONTROLLER_NEEDS_RESTART=true
  fi

  if [[ "${DRY_RUN}" == "true" ]]; then
    run_cmd "${REPO_ROOT}/dev/tasks/deploy" --dry-run "${DEPLOY_ARGS[@]+"${DEPLOY_ARGS[@]}"}"
    if [[ "${RESTART}" == "true" ]]; then
      for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
        run_cmd kubectl -n eval-runner rollout restart "deployment/${d}"
      done
    elif [[ "${CONTROLLER_NEEDS_RESTART}" == "true" ]]; then
      run_cmd kubectl -n eval-runner rollout restart deployment/eval-runner-controller
    fi
    for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
      run_cmd kubectl -n eval-runner rollout status "deployment/${d}" --timeout=300s
    done
    run_cmd kubectl -n eval-runner logs deployment/eval-runner-controller --since-time="${STARTED_TIME}"
  else
    "${REPO_ROOT}/dev/tasks/deploy" "${DEPLOY_ARGS[@]+"${DEPLOY_ARGS[@]}"}"
    if [[ "${RESTART}" == "true" ]]; then
      for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
        kubectl -n eval-runner rollout restart "deployment/${d}"
      done
    elif [[ "${CONTROLLER_NEEDS_RESTART}" == "true" ]]; then
      kubectl -n eval-runner rollout restart deployment/eval-runner-controller
    fi
    for d in eval-runner-controller eval-runner-ui eval-runner-webhook; do
      kubectl -n eval-runner rollout status "deployment/${d}" --timeout=300s
    done

    SINCE_ARG=""
    if [[ "${RESTART}" == "true" || "${CONTROLLER_NEEDS_RESTART}" == "true" ]]; then
      SINCE_ARG="${STARTED_TIME}"
    fi
    wait_for_effective_settings "${ARTIFACT_BUCKET}" "${SINCE_ARG}"
  fi

  if [[ "${GATEWAY_NAME}" != "hello-gw" || "${GATEWAY_NAMESPACE}" != "default" ]]; then
    step "Apply parameterized HTTPRoute (${GATEWAY_NAMESPACE}/${GATEWAY_NAME})"
    CUSTOM_ROUTE="apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hello
  namespace: ${GATEWAY_NAMESPACE}
  labels:
    app: eval-runner
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    sectionName: https
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /webhook
    backendRefs:
    - name: eval-runner-webhook
      namespace: eval-runner
      port: 80
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: eval-runner-ui
      namespace: eval-runner
      port: 80
---
apiVersion: gateway.networking.k8s.io/v1beta1
kind: ReferenceGrant
metadata:
  name: allow-default-httproutes
  namespace: eval-runner
spec:
  from:
  - group: gateway.networking.k8s.io
    kind: HTTPRoute
    namespace: ${GATEWAY_NAMESPACE}
  to:
  - group: \"\"
    kind: Service
    name: eval-runner-ui
  - group: \"\"
    kind: Service
    name: eval-runner-webhook"
    if [[ "${DRY_RUN}" == "true" ]]; then
      echo "kubectl apply -f - << 'EOF'"
      echo "${CUSTOM_ROUTE}"
      echo "EOF"
    else
      echo "${CUSTOM_ROUTE}" | kubectl apply -f -
    fi
  fi
fi

# Done
step "Done"
echo "    kubectl -n eval-runner get runs,comparisons"
echo "    kubectl -n eval-runner port-forward svc/eval-runner-ui 8080:80   # then open http://localhost:8080/"
echo "    Next: expose the UI behind your own ingress or gateway, and set uiBaseURL in the ConfigMap"
